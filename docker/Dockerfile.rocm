# doc-dev: docs/ci/02-docker-build.md
# Multi-arch ROCm image for Miles (built on a prebuilt sglang base):
#
# 1. rocm700-mi35x  (gfx950, ROCm 7.0 / MI350 / MI355X)
#    build-arg:SGLANG_IMAGE_REPO=rocm/sgl-dev  SGLANG_IMAGE_TAG=v0.5.14-rocm700-mi35x-20260627
#
# 2. rocm700-mi30x  (gfx942, ROCm 7.0 / MI300 / MI325)
#    build-arg:GPU_ARCH=gfx942  SGLANG_IMAGE_TAG=v0.5.10-rocm700-mi30x
#
# 3. rocm720-mi35x  (gfx950, ROCm 7.2 / MI350 / MI355X)
#    build-arg:SGLANG_IMAGE_REPO=rocm/sgl-dev  SGLANG_IMAGE_TAG=v0.5.16-rocm720-mi35x-20260730
#
# 4. rocm10-mi45x   (gfx1250, ROCm 10.0 / MI450 / MI455X)
#    build-arg:GPU_ARCH=gfx1250  SGLANG_IMAGE_REPO=rocm/sgl-dev
#              SGLANG_IMAGE_TAG=v0.5.18-rocm10-mi45x-20260904
#    This base is python3.12 and pip-installs the ROCm SDK (/opt/rocm is a symlink into
#    site-packages) rather than shipping /opt/rocm proper. Two gfx1250-specific pieces:
#      * its librccl has no gfx1250 device code (4 MB, .hip_fatbin NOBITS) and every
#        collective above ~4 KB corrupts data and then faults, so a working RCCL is
#        copied from the Primus gfx1250 image -- see RCCL_DONOR_IMAGE below. Building RCCL
#        from the SDK's own source revision (rocm-systems@6b0e43f3) against this ROCm was
#        tried first and is *not* a substitute: it links cleanly and carries a 23.8 MiB
#        PROGBITS .hip_fatbin with gfx1250 code, yet still faults in ncclDevKernel_Generic
#        at 1 MiB. Only the Primus build is measured good, so that is what ships;
#      * Transformer Engine has no gfx1250 wheel, so it is built from source here.
#    Installing a real RCCL has a second-order effect worth knowing about: it brings up
#    libamd_smi itself, after which torch's amdsmi-based device enumeration returns zero
#    while HIP still reports four cards. See patch_torch_amdsmi_device_count.py.

ARG SGLANG_IMAGE_REPO=lmsysorg/sglang
ARG SGLANG_IMAGE_TAG=v0.5.10-rocm700-mi35x

# ------------------------- RCCL donor (gfx1250 only) ------------------------------------------
# gfx950/gfx942 bases carry a working librccl, so USE_DONOR_RCCL=0 aliases the donor to the
# sglang base itself and nothing extra is pulled. gfx1250 sets it to 1 and takes the 94 MB
# gfx1250 RCCL build out of the Primus image; the ROCm 10 SDK's own librccl is device-code-less.
ARG RCCL_DONOR_IMAGE=amdprimus/amdprimus:gfx1250-20260831
# Must be declared here, before any FROM: only global ARGs are usable in a FROM line.
ARG USE_DONOR_RCCL=0

FROM ${SGLANG_IMAGE_REPO}:${SGLANG_IMAGE_TAG} AS rccl_donor_0
RUN mkdir -p /opt/rccl-gfx1250/lib

FROM ${RCCL_DONOR_IMAGE} AS rccl_donor_1
# Stage the one extra library the donor RCCL needs next to it, so the main stage copies a
# single self-contained directory and the USE_DONOR_RCCL=0 branch stays a no-op.
RUN cp "$(dirname "$(readlink -f "$(command -v hipcc || echo /opt/rocm/bin/hipcc)")")/../lib/libamd_smi.so.26" \
        /opt/rccl-gfx1250/lib/ 2>/dev/null \
    || cp /opt/venv/lib/python*/site-packages/_rocm_sdk_devel/lib/libamd_smi.so.26 /opt/rccl-gfx1250/lib/

FROM rccl_donor_${USE_DONOR_RCCL} AS rccl_donor

FROM ${SGLANG_IMAGE_REPO}:${SGLANG_IMAGE_TAG} AS sglang

SHELL ["/bin/bash", "-ceuxo", "pipefail"]

# ======================================== Arguments ============================================
ARG SGLANG_BRANCH=sglang-miles
ARG SGLANG_COMMIT=""

ARG MEGATRON_REPO=radixark/Megatron-LM
ARG MEGATRON_BRANCH=miles-main

ARG MILES_COMMIT=main

ARG GPU_ARCH=gfx950
# Re-declared: a global ARG is not visible inside a stage until the stage asks for it.
ARG USE_DONOR_RCCL=0
# 1 on ROCm 7.2 to bake the ROCr VMM-pause fix; ROCm 7.0 has no such regression, leave 0.
ARG APPLY_ROCR_VMMFIX=0
ARG SGLANG_USE_ROCM700A=0
ARG WHEELS_REPO=XinyuJiangCMU/miles-wheels-rocm
ARG WHEELS_TAG_ROCM=rocm720-gfx950-v0.5.16
ARG MAX_JOBS=128

ARG RCCL_TESTS_REPO=https://github.com/ROCm/rocm-systems.git
ARG RCCL_TESTS_COMMIT=746c7b3c9e78b094389e19499919fdd43a0b6a90
ARG RCCL_TESTS_PATH=projects/rccl-tests

ARG TRANSFORMER_ENGINE_REPO=https://github.com/ROCm/TransformerEngine.git
ARG TRANSFORMER_ENGINE_BRANCH=v2.8_rocm
# Optional exact commit; wins over the branch when set. gfx1250 pins the IFU-2.17 commit the
# Primus gfx1250 image is built from, which is the only TE revision measured on that part.
ARG TRANSFORMER_ENGINE_COMMIT=""
# NVTE_FUSED_ATTN=0 everywhere so far: the CK/aiter fused-attn path has no gfx1250 backend.
ARG NVTE_FUSED_ATTN=0
ARG MOONCAKE_VERSION=0.3.12.post1

ARG TARGETARCH

# ======================================== Setup ================================================
WORKDIR /root/

ENV MAX_JOBS=${MAX_JOBS}

# Build configuration for the selected arch (gfx942 / gfx950).
ENV GPU_ARCH=${GPU_ARCH}
ENV PYTORCH_ROCM_ARCH=${GPU_ARCH}
ENV GPU_ARCH_LIST=${GPU_ARCH}
ENV AMDGPU_TARGET=${GPU_ARCH}

# Transformer Engine build knobs for the v2.8_rocm branch.
ENV NVTE_FRAMEWORK=pytorch
ENV NVTE_ROCM_ARCH=${GPU_ARCH}
ENV NVTE_USE_HIPBLASLT=1
ENV NVTE_USE_ROCM=1
ENV CMAKE_PREFIX_PATH=/opt/rocm:/opt/rocm/hip:/usr/local:/usr

# Put the real ROCm binaries ahead of anything else on PATH. On a base that pip-installs the
# ROCm SDK (gfx1250), /opt/venv/bin/hipcc is a console-script shim that resolves its own
# package metadata at run time; under pip's build isolation that metadata is off sys.path and
# hipcc dies with "No package metadata was found for rocm-sdk-core", failing every extension
# that shells out to it. /opt/rocm/bin/hipcc is a plain ELF binary with no such dependency.
# Harmless on the gfx950/gfx942 bases, where /opt/rocm/bin is the real ROCm bin directory.
ENV PATH=/opt/rocm/bin:${PATH}

# The gfx950 bases are python3.10 and the gfx1250 base is python3.12, so no step below may
# hardcode a site-packages path.
RUN python3 -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])' > /tmp/site_packages.txt && \
    echo "[site-packages] $(cat /tmp/site_packages.txt)"

# The ROCm 10 base builds its own gfx1250 triton and installs it over the one torch was built
# against, under a different local version (3.8.0+git76940ad3 vs torch's pinned
# 3.8.0+git4cff872c.rocm10.0.0). torch's metadata then names a triton that exists on no index,
# so *every* pip resolve that reaches torch dies with "No matching distribution found for
# triton==..." -- Transformer Engine, modelopt and requirements.txt all hit it. Relax that one
# pin to a bare requirement, which the installed triton satisfies. Deliberately narrow: it
# only fires when the pin is genuinely unsatisfiable, so the gfx950/gfx942 bases are untouched.
COPY docker/relax_torch_triton_pin.py /tmp/relax_torch_triton_pin.py
RUN python3 /tmp/relax_torch_triton_pin.py && rm -f /tmp/relax_torch_triton_pin.py


# Patches + requirements consumed below.
# TODO: remove these patches once the changes are merged into the main codebase.
COPY docker/amd_patch/latest/tile_kernels.patch /tmp/amd_patch/tile_kernels.patch
COPY docker/amd_patch/latest/tilelang_hip_fp8.patch /tmp/amd_patch/tilelang_hip_fp8.patch
COPY requirements.txt /tmp/requirements.txt

# ======================================== Apt dependencies =====================================
RUN apt update
# Install build tools and diagnostics utilities.
RUN apt install -y build-essential cmake dnsutils ethtool git nvtop patch rsync

# Build rccl-tests diagnostics binaries.
RUN mkdir -p /tmp/rocm-systems && cd /tmp/rocm-systems && git init -q && \
    git remote add origin ${RCCL_TESTS_REPO} && \
    git fetch --depth 1 origin ${RCCL_TESTS_COMMIT} && git checkout -q FETCH_HEAD && \
    make -C ${RCCL_TESTS_PATH} -j$(nproc) \
      HIP_HOME=/opt/rocm NCCL_HOME=/opt/rocm GPU_TARGETS=${GPU_ARCH} && \
    cp ${RCCL_TESTS_PATH}/build/*_perf /usr/local/bin/ && \
    rm -rf /tmp/rocm-systems

# ====================================== Python dependencies ====================================
RUN pip install git+https://github.com/ISEEKYAN/mbridge.git@89eb10887887bc74853f89a4de258c0702932a1c --no-deps

# Prebuilt wheels from the miles-wheels-rocm release (Transformer Engine, flash-attn; gateway below).
RUN mkdir -p /tmp/wheels && \
    curl -fsSL "https://api.github.com/repos/${WHEELS_REPO}/releases/tags/${WHEELS_TAG_ROCM}" \
    | python3 -c "import sys,json,subprocess,os; w='/tmp/wheels'; [subprocess.run(['curl','-fsSL','-o',os.path.join(w,a['name']),a['browser_download_url']],check=True) for a in json.load(sys.stdin).get('assets',[]) if a['name'].endswith(('.whl','.tar.gz'))]" && \
    ls -lh /tmp/wheels/
# Transformer Engine: prebuilt fp8 wheel
ARG TE_USE_WHEEL=0
# A prebuilt TE in docker/prebuilt wins over both other paths. Compiling TE from source costs
# ~9 minutes and is the most expensive layer in this file, so any edit to a step above it pays
# that again; the gfx1250 variant therefore ships the wheel it would have produced. Rebuild it
# with docker/build_te_gfx1250.sh. The import check below is what proves the wheel matches
# this image's ROCm -- TE asserts on a build/runtime major mismatch.
COPY docker/prebuilt /tmp/prebuilt
RUN pip uninstall -y transformer-engine transformer_engine transformer_engine_torch || true; \
    if ls /tmp/prebuilt/transformer_engine-*.whl >/dev/null 2>&1; then \
      echo "[TE] installing prebuilt $(basename $(ls /tmp/prebuilt/transformer_engine-*.whl | head -1))" && \
      pip install --no-deps /tmp/prebuilt/transformer_engine-*.whl && \
      pip install pydantic nvdlfw-inspect onnx einops onnxscript "importlib-metadata>=1.0" packaging; \
    elif [ "${TE_USE_WHEEL}" = "1" ]; then \
      pip install /tmp/wheels/transformer_engine-*.whl; \
    else \
      rm -rf /root/TransformerEngine && \
      git clone --recursive --branch ${TRANSFORMER_ENGINE_BRANCH} ${TRANSFORMER_ENGINE_REPO} /root/TransformerEngine && \
      cd /root/TransformerEngine && \
      if [ -n "${TRANSFORMER_ENGINE_COMMIT}" ]; then \
        git fetch origin ${TRANSFORMER_ENGINE_COMMIT} && git checkout ${TRANSFORMER_ENGINE_COMMIT} && \
        git submodule update --init --recursive; \
      fi && \
      NVTE_FUSED_ATTN=${NVTE_FUSED_ATTN} pip install . --no-build-isolation -v; \
    fi
# TE asserts at import that its build-time ROCm major matches the runtime's, so a wheel built
# for another ROCm line fails loudly here rather than at first use.
RUN python -c "import transformer_engine, transformer_engine.pytorch; print('TE:', transformer_engine.__version__)"
# flash-attn has no gfx1250 wheel. Every miles import of it is guarded and falls back, so the
# gfx1250 variant ships without it rather than installing gfx950 device code that cannot run.
ARG INSTALL_FLASH_ATTN=1
RUN if [ "${INSTALL_FLASH_ATTN}" = "1" ]; then \
      pip install /tmp/wheels/flash_attn-*.whl; \
    else \
      echo "[flash-attn] skipped (INSTALL_FLASH_ATTN=${INSTALL_FLASH_ATTN}); miles guards every import of it"; \
    fi

# make install lays down mooncake's native modules but not its pure Python files.
RUN pip install --no-deps --target=/tmp/mc "mooncake-transfer-engine-non-cuda==${MOONCAKE_VERSION}" && \
    cp -n /tmp/mc/mooncake/*.py "$(python3 -c 'import mooncake, os; print(os.path.dirname(mooncake.__file__))')" && \
    rm -rf /tmp/mc

RUN pip install flash-linear-attention==0.5.2

# ------------------------------ apex (gfx1250) -------------------------------------------------
# Megatron's gradient_accumulation_fusion needs apex's fused_weight_gradient_mlp_cuda, and
# without it even checkpoint conversion stops with "the custom CUDA extension ... is not
# found". The miles ROCm 10 wheel release carries a gfx950 apex; this is the gfx1250 build of
# the same thing, made from ROCm/apex with APEX_BUILD_CPP_OPS=1 APEX_BUILD_CUDA_OPS=1.
#
# It is a prebuilt wheel rather than a build step because apex's setup.py imports torch, which
# pulls in aiter, which shells out to rocminfo -- and the build container has no GPU. Rebuild
# it with docker/build_apex_gfx1250.sh on a machine that does. For the same reason the check
# below looks for the extension file instead of importing it: the shim apex installs at
# site-packages root resolves the GPU arch on first attribute access, which cannot work here.
ARG INSTALL_APEX=0
RUN if [ "${INSTALL_APEX}" = "1" ]; then \
      pip install --no-deps /tmp/prebuilt/apex-*.whl && \
      python -c "import pathlib, sysconfig; d = pathlib.Path(sysconfig.get_paths()['purelib'], 'apex'); so = sorted(p.name for p in d.glob('fused_weight_gradient_mlp_cuda*.so')); assert so, 'apex wheel carried no fused_weight_gradient_mlp_cuda extension'; print('[apex] installed', so[0])"; \
    else \
      echo "[apex] skipped (INSTALL_APEX=${INSTALL_APEX}); Megatron will fall back to Torch Norm and gradient_accumulation_fusion must stay off"; \
    fi && rm -rf /tmp/prebuilt

# Enable deepseek-ai/TileKernels on ROCm/gfx950 for mHC and FP8 QAT cast-back.
# These temporary build-time patches make tile_kernels import lazy, remove CUDA/Hopper-only PDL from mhc_post,
# and fix TileLang's HIP fp8->float conversion to use ROCm device intrinsics instead of the SDK host-only operator.
# Drop these patches once the corresponding tilelang/tile_kernels fixes land in the base image.
RUN pip install --no-deps tile_kernels==1.0.0 && \
    patch -p1 -d "$(cat /tmp/site_packages.txt)" < /tmp/amd_patch/tile_kernels.patch && \
    patch -p1 -d /opt/tilelang/src/tl_templates/hip < /tmp/amd_patch/tilelang_hip_fp8.patch

RUN rm -rf /root/Megatron-LM && \
    git clone --recursive -b ${MEGATRON_BRANCH} https://github.com/${MEGATRON_REPO}.git /root/Megatron-LM && \
    cd /root/Megatron-LM && \
    pip install -e .

RUN cd /sgl-workspace/sglang && \
    git reset --hard && \
    git fetch origin ${SGLANG_BRANCH} && \
    if [ -n "${SGLANG_COMMIT}" ]; then \
      git checkout ${SGLANG_COMMIT}; \
    else \
      git checkout FETCH_HEAD; \
    fi && \
    pip install -e "python[all_hip]" --no-deps

# SGLang is installed without dependencies, but its Inkling multimodal processor imports numba.
RUN pip install "numba==0.65.1"

RUN python -c "import sglang; import sgl_kernel; print('SGLang + sgl_kernel: OK')"

RUN pip install git+https://github.com/fzyzcjy/torch_memory_saver.git@f05a8754daf68238d54e4cf31cb3ba866684bbaf --no-cache-dir --force-reinstall

# Fix the ROCm 7.2 ROCr VMM-pause leak.
RUN if [ "$APPLY_ROCR_VMMFIX" = "1" ]; then \
      asset="libhsa-runtime64.so.1.18.70200.vmmfix"; \
      curl -fsSL -o "/tmp/$asset" "https://github.com/${WHEELS_REPO}/releases/download/${WHEELS_TAG_ROCM}/$asset"; \
      dst="$(readlink -f /opt/rocm/lib/libhsa-runtime64.so.1)"; \
      case "$dst" in \
        *.1.18.70200) ;; \
        *) echo "[vmmfix] ROCr soname mismatch: $dst (expected .1.18.70200 = ROCm 7.2.0); rebuild the .so" >&2; exit 1 ;; \
      esac; \
      cp -a "$dst" /opt/libhsa-runtime64.so.stock-prevmmfix.bak && \
      install -m0644 "/tmp/$asset" "$dst" && rm -f "/tmp/$asset" && \
      echo "[vmmfix] installed patched ROCr at $dst"; \
    else \
      echo "[vmmfix] skipped (APPLY_ROCR_VMMFIX=$APPLY_ROCR_VMMFIX; ROCm 7.0 has no VMM-pause regression)"; \
    fi
# ------------------------------ gfx1250 RCCL ---------------------------------------------------
# The ROCm 10 SDK's librccl.so.1 is 4 MB with a NOBITS .hip_fatbin: no gfx1250 device code at
# all. Collectives up to ~4 KB take a path that does not need it and look fine; a 1 MiB
# all_reduce returns corrupted data and then faults in ncclDevKernel_Generic. The donor image
# carries a 94 MB gfx1250 build. Overriding the SDK copies in place (rather than prepending a
# LD_LIBRARY_PATH entry) keeps torch, RCCL-tests and any subprocess on the same library.
COPY --from=rccl_donor /opt/rccl-gfx1250 /opt/rccl-gfx1250
# The donor RCCL is a ROCm 7.15 build and needs libamd_smi.so.26; this base ships .so.27.
# That single soname is the *only* difference between the two libraries' DT_NEEDED lists
# (libamdhip64.so.7, libhsa-runtime64.so.1, librocm-core.so.1, libroctx64.so.4 and
# librocprofiler-register.so.0 all match), and RCCL uses amd_smi only to enumerate devices
# and topology. Without it torch cannot even import: rocm_sdk preloads librccl at startup.
COPY docker/install_gfx1250_rccl.py /tmp/install_gfx1250_rccl.py
COPY docker/patch_torch_amdsmi_device_count.py /tmp/patch_torch_amdsmi_device_count.py
# The obvious check here -- assert torch.cuda.device_count() > 0 -- cannot work: the build
# container has no /dev/kfd, so zero is the honest answer at this point. Verify the patch is
# in place instead and leave the device count to a run on real hardware.
RUN if [ "${USE_DONOR_RCCL}" = "1" ]; then \
      install -m0755 /opt/rccl-gfx1250/lib/libamd_smi.so.26 "${ROCM_HOME}/lib/libamd_smi.so.26" && \
      python3 /tmp/install_gfx1250_rccl.py /opt/rccl-gfx1250/lib/librccl.so.1 && \
      python3 /tmp/patch_torch_amdsmi_device_count.py && \
      python3 -c "from torch.cuda import _raw_device_count_amdsmi as f; import inspect; assert 'hipGetDeviceCount' in inspect.getsource(f), 'amdsmi fallback patch did not take'; print('[amdsmi] fallback verified')"; \
    else \
      echo "[rccl] skipped (USE_DONOR_RCCL=${USE_DONOR_RCCL}); base image RCCL kept"; \
    fi && rm -f /tmp/install_gfx1250_rccl.py /tmp/patch_torch_amdsmi_device_count.py

RUN pip install git+https://github.com/radixark/Megatron-Bridge.git@bridge --no-deps --no-build-isolation
RUN pip install megatron-energon --no-deps
RUN pip install multi-storage-client --no-deps

# Megatron post_training and Megatron-Bridge hard-import modelopt.
RUN pip install "nvidia-modelopt[torch]>=0.37.0" --no-build-isolation
# modelopt pulls setuptools up to 82, which drops pkg_resources and breaks deps that
# still import it; re-pin to the base image's setuptools.
RUN pip install "setuptools==79.0.1"

RUN rm -rf /usr/lib/python3/dist-packages/jwt /usr/lib/python3/dist-packages/PyJWT* && \
    sed -i '/nvidia-resiliency-ext/d' /tmp/requirements.txt && \
    pip install -r /tmp/requirements.txt

# Pin the CLI stack (typer/click) for huggingface_hub / Ray compatibility.
RUN pip install "typer==0.25.1" "click==8.2.1"

# Pin numpy 1.x for Megatron compatibility. The ROCm 10 base ships numpy 2.x and its torch
# 2.11 / sglang 0.5.18 build is compiled against it, so gfx1250 passes NUMPY_SPEC="" to keep it.
ARG NUMPY_SPEC="numpy<2"
RUN if [ -n "${NUMPY_SPEC}" ]; then \
      pip install "${NUMPY_SPEC}"; \
    else \
      echo "[numpy] left at the base image's $(python3 -c 'import numpy;print(numpy.__version__)')"; \
    fi

COPY docker/install-kube-tools.sh /tmp/install-kube-tools.sh
RUN bash /tmp/install-kube-tools.sh "${TARGETARCH}" && rm -f /tmp/install-kube-tools.sh

# ====================================== Install main package ===================================

RUN git clone https://github.com/radixark/miles.git /root/miles && \
    cd /root/miles && \
    git checkout ${MILES_COMMIT} && \
    pip install -e . --no-deps

RUN python -c "import miles.backends.fsdp_utils; import miles.backends.megatron_utils; print('miles backends: OK')"

# ====================================== Install sgl-model-gateway ============================================
# SGL_ROUTER_USE_WHEELS=1 (default): prebuilt sgl-router wheel + gateway binary; 0: build from source.
ARG SGL_ROUTER_USE_WHEELS=1
ARG SGL_ROUTER_REPO=https://github.com/radixark/sgl-router-for-miles.git
ARG SGL_ROUTER_BRANCH=main

RUN --mount=type=cache,target=/root/.cache/pip \
    set -eux; \
    if [ "${SGL_ROUTER_USE_WHEELS}" = "1" ]; then \
      pip install --force-reinstall --no-deps /tmp/wheels/sglang_router-*.whl && \
      tar xzf /tmp/wheels/sgl-model-gateway-linux-*.tar.gz -C /usr/local/bin/ && \
      chmod +x /usr/local/bin/sgl-model-gateway; \
    else \
      export PATH="/root/.cargo/bin:${PATH}" && \
      { command -v cargo >/dev/null 2>&1 || curl --proto '=https' --tlsv1.2 --retry 3 --retry-delay 2 -sSf https://sh.rustup.rs | sh -s -- -y; } && \
      python3 -m pip install maturin && \
      git clone --branch "${SGL_ROUTER_BRANCH}" --depth 1 "${SGL_ROUTER_REPO}" /build/sgl-model-gateway && \
      ( cd /build/sgl-model-gateway/bindings/python && ulimit -n 65536 && maturin build --release --features vendored-openssl --out /build/gateway_wheels ) && \
      ( cd /build/sgl-model-gateway && cargo build --release --bin sgl-model-gateway --features vendored-openssl ) && \
      cp /build/sgl-model-gateway/target/release/sgl-model-gateway /usr/local/bin/sgl-model-gateway && \
      chmod +x /usr/local/bin/sgl-model-gateway && \
      pip install --force-reinstall --no-deps /build/gateway_wheels/sglang_router-*.whl && \
      rm -rf /root/.cargo /root/.rustup /build/sgl-model-gateway /build/gateway_wheels; \
    fi

RUN rm -rf /tmp/wheels

# ====================================== Runtime knobs ==========================================

# Runtime knobs consumed by the current SGLang/PyTorch stack.
# Lets scripts and tests pick the ROCm recipe without probing the device.
ENV MILES_HARDWARE_PLATFORM=rocm
ENV HIP_FORCE_DEV_KERNARG=1
# ROCm 7.2 switched IPC to dma-buf, which leaks exported VRAM in colocate; force legacy IPC to avoid it.
ARG HSA_ENABLE_IPC_MODE_LEGACY=1
ENV HSA_ENABLE_IPC_MODE_LEGACY=${HSA_ENABLE_IPC_MODE_LEGACY}
# Where the gfx1250 RCCL was unpacked. The SDK copy is already overridden above, so this only
# exists for launchers that want to point at it explicitly (Primus reads RCCL_LIB_DIR).
ENV RCCL_LIB_DIR=/opt/rccl-gfx1250
ENV HSA_NO_SCRATCH_RECLAIM=1
ENV SGLANG_USE_AITER=1
ENV SGLANG_ALLOW_OVERWRITE_LONGER_CONTEXT_LEN=1
ENV SGLANG_MOE_PADDING=1
ENV SGLANG_SET_CPU_AFFINITY=1
ENV SGLANG_ROCM_FUSED_DECODE_MLA=1
ENV SGLANG_USE_ROCM700A=${SGLANG_USE_ROCM700A}
ENV NCCL_MIN_NCHANNELS=112
ENV TORCHINDUCTOR_MAX_AUTOTUNE=1
ENV TORCHINDUCTOR_MAX_AUTOTUNE_POINTWISE=1
# Keep GPUs visible to Ray num_gpus=0 coordinators so Megatron device checks do not crash.
ENV RAY_ACCEL_ENV_VAR_OVERRIDE_ON_ZERO=0

# Collapse the SDK's byte-identical duplicate libraries onto one inode each. Must be the last
# thing that touches site-packages: the fix is a set of symlinks, and any later step that
# rewrites one of these files would quietly undo it. See the script for why it is needed.
COPY docker/dedupe_rocm_sdk_libs.py /tmp/dedupe_rocm_sdk_libs.py
RUN python3 /tmp/dedupe_rocm_sdk_libs.py && \
    python3 -c "import os, sysconfig, pathlib; s = pathlib.Path(sysconfig.get_paths()['purelib']); a = s/'_rocm_sdk_devel/lib/libamd_comgr.so.3'; b = s/'_rocm_sdk_core/lib/libamd_comgr.so.3'; assert not a.exists() or not b.exists() or os.path.samefile(a, b), 'libamd_comgr.so.3 is still two inodes'; print('[sdk-dedupe] libamd_comgr.so.3 verified as one inode')" && \
    rm -f /tmp/dedupe_rocm_sdk_libs.py

RUN rm -rf /root/.cache/pip /root/TransformerEngine /tmp/amd_patch

WORKDIR /root/

CMD ["/usr/bin/bash"]
